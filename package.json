{
  "name": "fastclock",
  "description": "A free intermittent fasting timer with presets and a live progress ring. Private and offline.",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freeappstore-online/fastclock.git"
  },
  "scripts": {
    "dev": "pnpm --filter @fastclock/web dev",
    "build": "pnpm --filter @fastclock/web build",
    "preview": "pnpm --filter @fastclock/web preview",
    "typecheck": "pnpm --filter @fastclock/web exec tsc -b && pnpm --filter @fastclock/web exec tsc -p ../e2e",
    "e2e": "pnpm build && playwright test",
    "test": "pnpm typecheck && pnpm --filter @fastclock/web test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "playwright": "^1.64.1"
  }
}
